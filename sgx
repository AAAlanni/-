<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>邵光绪 | 智能垃圾桶宣传官网</title>
    <style>
        /* --- 核心变量与后现代设计系统 --- */
        :root {
            --primary-neon: #00ffcc;
            --secondary-neon: #7000ff;
            --accent-pink: #ff007a;
            --bg-deep: #050507;
            --text-main: #ffffff;
            --glass: rgba(255, 255, 255, 0.05);
            --transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', 'PingFang SC', sans-serif; }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* --- 后现代动态背景元素 --- */
        .dynamic-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            background: radial-gradient(circle at 50% 50%, #0c0c1e 0%, #050507 100%);
            overflow: hidden;
        }

        .blob {
            position: absolute;
            width: 600px; height: 600px;
            background: var(--secondary-neon);
            filter: blur(120px);
            border-radius: 50%;
            opacity: 0.3;
            animation: float 20s infinite alternate ease-in-out;
        }
        .blob-2 { background: var(--primary-neon); right: -10%; top: 20%; animation-delay: -7s; }
        .blob-3 { background: var(--accent-pink); left: 10%; bottom: -10%; animation-delay: -12s; }

        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(100px, 50px) scale(1.2); }
        }

        /* --- 导航栏 --- */
        nav {
            position: fixed;
            top: 0; width: 100%;
            padding: 25px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(25px);
            background: rgba(5, 5, 7, 0.8);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            z-index: 1000;
        }

        .logo {
            font-size: 1.6rem;
            font-weight: 900;
            letter-spacing: 3px;
            text-transform: uppercase;
            background: linear-gradient(90deg, var(--primary-neon), #fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links button {
            background: none; border: none; color: #fff;
            margin-left: 30px; cursor: pointer;
            font-size: 0.85rem; font-weight: 600;
            text-transform: uppercase; transition: var(--transition);
            letter-spacing: 1px;
        }
        .nav-links button:hover { color: var(--primary-neon); transform: translateY(-2px); }

        .lang-switch {
            border: 1px solid var(--primary-neon) !important;
            padding: 5px 18px; border-radius: 30px;
        }

        /* --- 内容容器 --- */
        .content-wrapper {
            padding-top: 120px;
            max-width: 1300px;
            margin: 0 auto;
            width: 90%;
        }

        .page {
            display: none;
            padding: 40px 0;
            animation: fadeIn 0.8s forwards ease-out;
        }
        .page.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- 首页 (智能垃圾桶 + 视频) --- */
        .hero { display: flex; align-items: center; min-height: 70vh; gap: 60px; }
        
        .hero-text { flex: 1; }
        .hero-text h1 {
            font-size: 6rem; line-height: 1;
            font-weight: 900; text-transform: uppercase;
            margin-bottom: 20px;
            text-shadow: 10px 10px 0 rgba(112, 0, 255, 0.3);
        }

        .video-box {
            flex: 1.2;
            position: relative;
            border: 2px solid #fff;
            padding: 15px;
            background: var(--glass);
            box-shadow: 25px 25px 0 var(--secondary-neon);
        }
        video { width: 100%; display: block; box-shadow: 0 0 30px rgba(0,0,0,0.5); }

        /* --- 功能特点板块 --- */
        .features-header { text-align: center; margin-bottom: 60px; }
        .features-header h2 { font-size: 3.5rem; text-transform: uppercase; }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 40px;
        }
        .feature-card {
            background: var(--glass);
            padding: 50px;
            border: 1px solid rgba(255,255,255,0.1);
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }
        .feature-card:hover {
            background: rgba(255,255,255,0.1);
            border-color: var(--primary-neon);
            transform: scale(1.03) rotate(-1deg);
        }
        .feature-card::before {
            content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--primary-neon);
        }
        .feature-card h3 { font-size: 1.8rem; margin-bottom: 20px; color: var(--primary-neon); }
        .feature-card p { font-size: 1.1rem; color: #ccc; line-height: 1.8; }

        /* --- 关于作者板块 --- */
        .profile-card {
            background: var(--glass);
            display: flex; gap: 60px;
            padding: 80px; border: 2px solid #fff;
            align-items: center; flex-wrap: wrap;
            backdrop-filter: blur(10px);
        }
        .avatar {
            width: 220px; height: 220px;
            background: var(--secondary-neon);
            border-radius: 50%; display: flex; justify-content: center; align-items: center;
            font-size: 5rem; border: 4px solid var(--primary-neon);
            box-shadow: 0 0 50px var(--secondary-neon);
        }

        .info-list { list-style: none; }
        .info-list li { margin-bottom: 20px; font-size: 1.2rem; }
        .info-list b { color: var(--primary-neon); margin-right: 15px; text-transform: uppercase; letter-spacing: 1px; }

        footer {
            margin-top: 120px; padding: 60px;
            text-align: center; border-top: 1px solid rgba(255,255,255,0.05);
            font-size: 0.75rem; letter-spacing: 4px; color: #444;
        }

        /* --- 响应式 --- */
        @media (max-width: 1024px) {
            .hero { flex-direction: column; text-align: center; }
            .hero-text h1 { font-size: 4rem; }
            .video-box { width: 100%; box-shadow: 15px 15px 0 var(--secondary-neon); }
        }
    </style>
</head>
<body>

    <div class="dynamic-bg">
