                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </section>

        <!-- 板块 2: 功能特点 -->
        <section id="features" class="page">
            <div class="features-header">
                <h2 data-zh="核心技术解析" data-en="CORE FEATURES">核心技术解析</h2>
            </div>
