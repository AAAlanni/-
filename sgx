        </section>

        <!-- 板块 3: 个人信息 -->
        <section id="about" class="page">
            <div class="profile-card">
                <div class="avatar">👨‍💻</div>
                <div class="info-details">
                    <h2 data-zh="制作人信息" data-en="PRODUCER INFO">制作人信息</h2>
